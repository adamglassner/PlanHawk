<Window x:Class="PlanHawk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:PlanHawk.Models"
        Title="PlanHawk"
        Icon="pack://application:,,,/Assets/planhawk.ico"
        Width="1400" Height="900" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13.5"
        UseLayoutRounding="True">
    <Grid Background="{DynamicResource Brush.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar (Hawkline) ===== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" Padding="16,22,16,14">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
                    <Image Source="pack://application:,,,/Assets/planhawk.png" Width="34" Height="34" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Text="PlanHawk" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.SidebarText}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- New task + search -->
                <Button DockPanel.Dock="Top" Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Stretch" Padding="14,10"
                        Margin="0,0,0,10" Click="NewTask_Click" ToolTip="New task (Ctrl+N)" AutomationProperties.Name="New task">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{x:Static m:Ic.ChevronDown}" Style="{StaticResource Icon}" FontSize="11" Opacity="0.8" />
                        <TextBlock Text="{x:Static m:Ic.Add}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="New task" FontSize="14" />
                    </DockPanel>
                </Button>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.SidebarCard}" CornerRadius="10" Padding="12,9" Margin="0,0,0,14"
                        Cursor="Hand" MouseLeftButtonUp="Search_Click" AutomationProperties.Name="Search">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+F" FontSize="11" Foreground="{DynamicResource Brush.SidebarMuted}" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static m:Ic.Search}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource Brush.SidebarMuted}" />
                        <TextBlock Text="Search tasks" Foreground="{DynamicResource Brush.SidebarMuted}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Bottom: sync status, theme, settings -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource Brush.SidebarCard}" CornerRadius="14" Padding="14,12" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static m:Ic.Cloud}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"
                                           Foreground="{DynamicResource Brush.Highlight}" />
                                <TextBlock Text="Preview build" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SidebarText}" />
                            </StackPanel>
                            <TextBlock x:Name="SyncDetail" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="17"
                                       Foreground="{DynamicResource Brush.SidebarMuted}"
                                       Text="Sample projects only. Saving, opening .mpp files and PlanHawk Server sync are coming soon." />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ThemeButton" Style="{StaticResource SidebarButton}" Click="Theme_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Icon}" FontSize="16" Width="30" />
                            <TextBlock x:Name="ThemeLabel" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SidebarButton}" Click="Settings_Click" ToolTip="Settings (Ctrl+,)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static m:Ic.Settings}" Style="{StaticResource Icon}" FontSize="16" Width="30" />
                            <TextBlock Text="Settings" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation + projects (scrolls if the window is short) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,0,8">
                    <StackPanel>
                        <ItemsControl x:Name="NavList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource NavRadio}" GroupName="MainNav"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 ToolTip="{Binding Tagline}"
                                                 AutomationProperties.Name="{Binding Title}"
                                                 Checked="Nav_Checked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="14,18,4,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Padding="4" MinHeight="24" Click="NewProject_Click"
                                    Foreground="{DynamicResource Brush.SidebarMuted}" ToolTip="New project" AutomationProperties.Name="New project">
                                <TextBlock Text="{x:Static m:Ic.Add}" Style="{StaticResource Icon}" FontSize="13" />
                            </Button>
                            <TextBlock Text="PROJECTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.SidebarMuted}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel x:Name="ProjectList" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="PageHost" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift" />
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- Toast -->
            <Border x:Name="Toast" Visibility="Collapsed" Opacity="0"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,40"
                    Background="{DynamicResource Brush.ToastBg}" CornerRadius="12" Padding="16,12" MaxWidth="460">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static m:Ic.Sparkle}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Highlight}" />
                    <TextBlock x:Name="ToastText" Foreground="{DynamicResource Brush.ToastText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
